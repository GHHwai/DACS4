+    }
+
+    public function attachments(): HasMany
+    {
+        return $this->hasMany(Attachment::class);
+    }
+
+    /** JSON shape shared by REST, WebSocket and TCP clients. */
+    public function toPayload(): array
+    {
+        $deleted = $this->deleted_at !== null;
+
