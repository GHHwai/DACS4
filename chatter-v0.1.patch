+    protected $fillable = [
+        'conversation_id', 'user_id', 'type', 'body',
+        'spam_label', 'spam_score', 'scanned_at', 'deleted_at',
+    ];
+
+    protected function casts(): array
+    {
+        return [
+            'spam_score' => 'float',
+            'scanned_at' => 'datetime',
+            'deleted_at' => 'datetime',
+        ];
